{
  "name": "@codeguide/ui-library",
  "version": "0.0.1",
  "description": "React UI component library with design tokens, theming, and Storybook integration",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "storybook",
    "figma",
    "tokens",
    "theming",
    "tailwind"
  ],
  "author": "CodeGuide Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/codeguide-ui-library.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/codeguide-ui-library/issues"
  },
  "homepage": "https://github.com/your-org/codeguide-ui-library#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build": "npx tsup",
    "dev": "npx tsup --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "npx jest",
    "test:watch": "npx jest --watch",
    "test:coverage": "npx jest --coverage",
    "test:ci": "npx jest --coverage --watchAll=false",
    "lint": "eslint src --ext .ts,.tsx --fix",
    "tokens:sync": "node scripts/sync-tokens.js",
    "tokens:watch": "node scripts/sync-tokens.js --watch",
    "build:tokens": "npm run tokens:sync && npm run build",
    "prepublishOnly": "npm run test:ci && npm run lint && npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@storybook/addon-essentials": "^8.5.0",
    "@storybook/addon-interactions": "^8.5.0",
    "@storybook/addon-links": "^8.5.0",
    "@storybook/blocks": "^8.5.0",
    "@storybook/react": "^8.5.0",
    "@storybook/react-webpack5": "^8.5.0",
    "@storybook/test": "^8.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.2.59",
    "@types/react-dom": "^18.2.19",
    "autoprefixer": "^10.4.20",
    "babel-jest": "^30.2.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.5.2",
    "storybook": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
